load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(
    [
        "contract-modules.lock.json",
        "go.mod",
    ],
    visibility = ["//visibility:public"],
)

# This target runs the real nested-module executable's -print-contract path,
# then the focused mutation and routing harness. The harness guards every
# benchmark command with a fake, so Bazel acceptance never opens a database,
# seeds a corpus, or runs the expensive benchmark.
filegroup(
    name = "authz_sources",
    srcs = glob(
        [
            "**",
        ],
        exclude = [
            "BUILD.bazel",
            "bazel-manifest-contract-test.sh",
        ],
    ),
    visibility = ["//visibility:private"],
)

sh_test(
    name = "manifest_contract_test",
    size = "medium",
    srcs = ["bazel-manifest-contract-test.sh"],
    args = [
        "$(rlocationpath @go_sdk//:bin/go)",
        "$(rlocationpath @authz_contract_goproxy//:proxy/ROOT)",
    ],
    data = [
        ":authz_sources",
        "@authz_contract_goproxy//:proxy",
        "@authz_contract_goproxy//:proxy/ROOT",
        "@go_sdk//:bin/go",
        "@go_sdk//:files",
    ],
    tags = ["block-network"],
)

