module(
    name = "plugs",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# Keep Bazel's default SDK aligned with the toolchain directive in go.mod.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.10")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_google_uuid",
    "com_github_gowebpki_jcs",
    "com_github_jackc_pgx_v5",
    "com_github_tetratelabs_wazero",
    "org_golang_x_sys",
    "org_modernc_sqlite",
)

lexicon_sources = use_repo_rule("//tools/lexicon:inventory.bzl", "lexicon_sources")

lexicon_sources(
    name = "lexicon_sources",
    root_file = "//:MODULE.bazel",
)

# Disposable public-native RunsOn tests use the same pinned Linux/amd64 Dolt
# release as accepted Beads source 305fec3a (tools/bazel/dolt.bzl). Bazel
# verifies the complete upstream archive before exposing its one executable.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "dolt_native_linux_amd64",
    urls = ["https://github.com/dolthub/dolt/releases/download/v2.2.0/dolt-linux-amd64.tar.gz"],
    sha256 = "1f7ad8c2622995789420a3fb0f2d16b4aa7430000a825dd91d5938f36480cbf6",
    strip_prefix = "dolt-linux-amd64/bin",
    build_file_content = 'exports_files(["dolt"], visibility = ["//visibility:public"])',
)

# Capture-only private driver extension, pinned upstream v2.2.0 source.
local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")
local_repository(name = "private_dolt_driver", path = "third_party/dolt-driver")
override_repo(go_deps, com_github_dolthub_driver_v2 = "private_dolt_driver")
use_repo(go_deps, "com_github_dolthub_eventsapi_schema")

# The embedded driver builds go-mysql-server with its stdlib-regex backend (ICU policy):
# gazelle must see gms_pure_go as satisfied so it selects regex_pure.go and
# drops the go-icu-regex (libicu, cgo) edge entirely.
go_deps.gazelle_override(
    directives = [
        "gazelle:build_tags gms_pure_go",
        "gazelle:exclude internal/regex/regex_cgo.go",
    ],
    path = "github.com/dolthub/go-mysql-server",
)

# protoc-gen-validate ships validate/validate.pb.go, so its Go library can
# compile from the checked-in code. Its own validate/BUILD instead makes the
# Go library a go_proto_library, so every lane built protoc from source just
# to regenerate that file: about 4.5k C++ compile, link and archive actions,
# each carrying the LLVM toolchain as inputs. The module reaches the graph
# only through grpc xds and the cloud SDKs. Gazelle regenerates its BUILD
# files with proto rules off; build_file_name makes it write BUILD.bazel (which
# Bazel prefers) rather than merge into the upstream BUILD files.
go_deps.gazelle_override(
    build_file_generation = "on",
    directives = [
        "gazelle:build_file_name BUILD.bazel",
        "gazelle:proto disable",
    ],
    path = "github.com/envoyproxy/protoc-gen-validate",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:eventsapi_schema_build.patch"],
    path = "github.com/dolthub/eventsapi_schema",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:flatbuffers_v23_importpath.patch"],
    path = "github.com/dolthub/flatbuffers/v23",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:dolt_go_serial.patch"],
    path = "github.com/dolthub/dolt/go",
)

use_repo(go_deps, "com_github_cenkalti_backoff_v4", "com_github_dolthub_dolt_go", "com_github_dolthub_driver_v2", "com_github_dolthub_go_mysql_server", "com_github_dolthub_vitess", "com_github_go_sql_driver_mysql")
