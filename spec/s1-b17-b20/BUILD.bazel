load("@rules_go//go:def.bzl", "go_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

go_test(
    name = "s1_b17_b20_i6_test",
    srcs = glob(["*_test.go"]),
    embedsrcs = glob([
        "reference/b18/*.json",
        "reference/b18/record.py",
        "reference/b20/*.json",
        "reference/b20/record_reference.py",
        "reference/b19_reference.json",
        "testdata/**",
    ]),
    data = [
        "//internal/integration/converterroundtrip:testdata/synthetic-plug-dump-1.tar",
        "//spec/recorded:lexicon_files",
    ] + glob(["reference/b18/*.json"]),
    args = ["-test.v"],
    tags = ["local", "requires-network"],
    timeout = "long",
    deps = [
        "//internal/api/wire",
        "//internal/testclock",
        "//internal/server/authzrpc",
        "//internal/plugins/authzfixed",
        "//internal/plugins/authnapikey",
        "//internal/core/authz",
        "//internal/cli",
        "//internal/core/dumpformat",
        "//internal/core/events",
        "//internal/core/model",
        "//internal/core/pipeline",
        "//internal/core/restore",
        "//internal/core/reverseconverter",
        "//internal/core/service",
        "//internal/integration/converterroundtrip",
        "//internal/server/composition",
        "//internal/server/pluginhost",
        "//plugins/workflow",
        "//internal/server/events",
        "//internal/server/rpc",
        "//internal/server/watch",
        "//internal/server/watchhttp",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/postgres",
        "//internal/storage/sqlite",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

# RunsOn source compile/vet only; no test cases execute through this route.
sh_binary(
    name = "b20_source_compile",
    srcs = ["b20_source_compile.sh"],
    tags = ["manual"],
)

# Authoring only: owning reconciliation/generation and scoped formatting on RunsOn.
sh_binary(
    name = "b17_b18_authoring",
    srcs = ["b17_b18_authoring.sh"],
    tags = ["manual"],
)
