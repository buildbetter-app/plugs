load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_go//go:def.bzl", "go_test")

COMMON = ["fixture_test.go", "query_support_test.go"]
DEPS = [
    "//internal/core/dumpformat",
    "//internal/core/model",
    "//internal/core/ontology",
    "//internal/core/pipeline",
    "//internal/core/service",
    "//internal/core/viewops",
    "//internal/server/rpc",
    "//internal/server/viewrpc",
    "//internal/storage/driver",
    "//internal/storage/memory",
    "//internal/storage/postgres",
    "//internal/storage/sqlite",
    "//internal/testclock",
    "//internal/integration/b07positive",
    "//internal/integration/b07positive/public",
    "//internal/integration/converterroundtrip",
    "//plugins/workflow",
]

go_test(
    name = "public_query_test",
    srcs = COMMON + ["query_test.go", "ready_planes_test.go", "ready_pages_test.go"],
    args = ["-test.v"],
    size = "large",
    tags = ["local", "requires-network"],
    timeout = "long",
    deps = DEPS,
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "b23_native_rich_fixture",
    srcs = glob(["testdata/native-rich-review-project/**"]),
    visibility = ["//visibility:public"],
)

# Generation runs only on RunsOn. Its output is applied before product gates;
# this target is generation evidence, not a behavior test or whole substitute.
sh_test(
    name = "regenerate_contract",
    srcs = ["regenerate_contract.sh"],
    data = [
        "//:engdocs/design/plug/contracts/openrpc.json",
        "//internal/api/wire:lexicon_files",
        "//scripts/ci:reconcile_generator",
    ],
    tags = ["manual"],
)

go_test(
    name = "native_query_test",
    srcs = COMMON + ["native_query_test.go", "native_cap_test.go", "native_history_test.go", "//spec/cardb20:native_build_support"],
    args = ["-test.v"],
    data = [":b23_native_rich_fixture", "//spec/s1-b09-native:lexicon_files", "//internal/publicnative:dolt_runtime"],
    env = {"PLUG_PINNED_DOLT_BINARY": "$(rlocationpath //internal/publicnative:dolt_runtime)"},
    env_inherit = ["BAZEL_BIN", "BAZEL_RC", "BAZELISK_HOME", "BAZELISK_VERIFY_SHA256"],
    size = "enormous",
    tags = ["local", "manual"],
    timeout = "eternal",
    deps = DEPS + ["//internal/publicnative"],
)
