load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "acceptance_test",
    srcs = [
        "acceptance_test.go",
        "converter_test.go",
        "reference_test.go",
    ],
    args = ["-test.v"],
    data = glob(["testdata/**"]) + [
        "record_reference.py",
        "provenance.py",
        "b26-deviation.json",
        "//internal/integration/converterroundtrip:testdata/synthetic-plug-dump-1.tar",
    ],
    deps = [
        "//internal/core/dumpformat",
        "//internal/core/model",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/core/service",
        "//internal/integration/converterroundtrip",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/sqlite",
    ],
)

# This target is intentionally manual: RunsOn prepares the pinned public
# companion executable only when the caller supplies PLUG_PUBLIC_BUNDLE.
go_test(
    name = "public_recording_test",
    srcs = ["public_recording_test.go"],
    args = ["-test.v", "-public-recording"],
    data = [
        "testdata/public-companion-profile.json",
        "testdata/public-recording-fixture.json",
    ],
    tags = ["manual"],
    timeout = "long",
    deps = ["//internal/core/dumpformat"],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
