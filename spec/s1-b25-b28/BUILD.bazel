# This target is intentionally manual: RunsOn prepares the pinned public
# native executable only when the caller supplies its trusted PLUG_PUBLIC_BUNDLE.
go_test(
    name = "public_recording_test",
    size = "large",
    srcs = ["public_recording_test.go"],
    args = ["-test.v", "-public-recording", "-test.run=^TestPublicNativeRecording$$"],
    data = [
        "compare_r418_pair.py",
        "compare_r418_pair_test.py",
        "testdata/native-public-profile.json",
        "testdata/native-public-recording-fixture.json",
        "testdata/native-product-source-binding.json",
        "//internal/publicnative:dolt_runtime",
    ],
    env = {
        "PLUG_PINNED_DOLT_BINARY": "$(rlocationpath //internal/publicnative:dolt_runtime)",
    },
    tags = ["local", "manual", "requires-network"],
    timeout = "long",
    deps = [
        "//internal/core/dumpformat",
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/core/service",
        "//internal/integration/converterroundtrip",
        "//internal/publicnative",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/postgres",
        "//internal/storage/sqlite",
        "//internal/testclock",
    ],
)

# Measurement-only controls can run while public producer delivery is blocked.
# Their PASS is never paired-recording or behavior-card qualification.
go_test(
    name = "recorder_validation_test",
    size = "large",
    srcs = ["public_recording_test.go"],
    args = ["-test.v", "-test.run=^TestPublicProjection"],
    data = [
        "//internal/integration/converterroundtrip:testdata/synthetic-plug-dump-1.tar",
        "testdata/native-public-profile.json",
        "testdata/native-public-recording-fixture.json",
    ],
    tags = ["local", "requires-network"],
    deps = [
        "//internal/core/dumpformat",
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/core/service",
        "//internal/integration/converterroundtrip",
        "//internal/publicnative",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/postgres",
        "//internal/storage/sqlite",
        "//internal/testclock",
    ],
)

# Existing independent expected protocol data, shared without copying it.
filegroup(
    name = "public_recording_protocol",
    srcs = ["testdata/public-recording-fixture.json"],
    visibility = ["//tools/roundtrip:__pkg__"],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

# Offline byte-bound analysis of the fresh R418 recording pair.
exports_files(["compare_r418_pair.py", "compare_r418_pair_test.py"])
