load("@rules_go//go:def.bzl", "go_test")

DEPS = [
    "//internal/core/model",
    "//internal/core/ontology",
    "//internal/core/pipeline",
    "//internal/core/service",
    "//internal/server/pluginhost",
    "//internal/server/rpc",
    "//internal/storage/conformance",
    "//internal/storage/driver",
    "//internal/storage/memory",
    "//internal/storage/postgres",
    "//internal/storage/sqlite",
    "//internal/testclock",
    "//plugins/workflow",
]

go_test(
    name = "public_test",
    srcs = ["public_fixture_test.go", "public_test.go"],
    args = ["-test.v"],
    deps = DEPS,
    size = "large",
    tags = ["local", "requires-network"],
    timeout = "long",
)

go_test(
    name = "attachment_test",
    srcs = ["public_fixture_test.go", "attachment_test.go"],
    args = ["-test.v"],
    deps = DEPS + ["//internal/core/port"],
    size = "large",
    tags = ["local", "requires-network"],
    timeout = "long",
)

# The canonical native recording uses the existing exact-source build support.
# Its manual target is selected explicitly in the owning focus gate.
go_test(
    name = "native_test",
    srcs = ["native_test.go", "public_fixture_test.go", "//spec/cardb20:native_build_support"],
    args = ["-test.v"],
    deps = DEPS + ["//internal/publicnative"],
    data = ["//spec/s1-b09-native:lexicon_files", "//internal/publicnative:dolt_runtime"],
    env = {"PLUG_PINNED_DOLT_BINARY": "$(rlocationpath //internal/publicnative:dolt_runtime)"},
    size = "enormous",
    tags = ["local", "manual"],
    timeout = "eternal",
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
