        "//internal/server/composition",
        "//internal/server/transport/httpjson",
        "//internal/server/watch",
        "//internal/storage/driver",
        "//internal/storage/postgres",
    ],
)

# The trusted workflow prepares the pinned public reference only when this
# explicit target is invoked with its fixed PLUG_PUBLIC_REFERENCE descriptor.
# Keep it out of wildcard/whole-tree runs: the prepared paths exist only on
# that RunsOn route and the test must never fall back to a local artifact.
sh_test(
    name = "prepared_reference_route",
    srcs = ["prepared_reference_test.py"],
    data = [
        "prepared_reference_test.py",
        "record_reference.py",
        "project_reference.py",
        "reference_inputs.py",
    ],
    tags = ["manual", "requires-network"],
    size = "large",
)

