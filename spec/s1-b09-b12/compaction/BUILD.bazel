load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "compaction_test",
    size = "large",
    srcs = glob(["*_test.go"]),
    args = ["-test.v"],
    data = ["//spec/cardb12:native_vectors"],
    tags = ["local", "requires-network"],
    deps = [
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/core/service",
        "//internal/server/rpc",
        "//internal/server/composition",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/postgres",
        "//internal/storage/sqlite",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

# Use --test_filter=^TestB11B12ReopenCompactionIdentityRefusalAndAllocationRetry$
# for the isolated continuation candidate; the existing glob owns its sources.
test_suite(
    name = "b11_b12_reopen_identity",
    tests = [":compaction_test"],
)
