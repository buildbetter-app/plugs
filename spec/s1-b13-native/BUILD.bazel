load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "recording",
    srcs = ["oracle_test.go", "recording_test.go"],
    size = "enormous",
    timeout = "eternal",
    tags = ["exclusive", "local", "manual", "requires-network"],
    args = ["-test.v"],
    data = ["//internal/publicnative:dolt_runtime"],
    env = {"PLUG_PINNED_DOLT_BINARY": "$(rlocationpath //internal/publicnative:dolt_runtime)"},
    deps = [
        "//internal/api/wire",
        "//internal/core/dumpformat",
        "//internal/core/model",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/core/service",
        "//internal/integration/converterroundtrip",
        "//internal/publicnative",
        "//internal/server/authn",
        "//internal/server/rpc",
        "//internal/server/transport/httpjson",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/postgres",
        "//internal/storage/sqlite",
        "//internal/testclock",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
