load("@rules_go//go:def.bzl", "go_test")

COMMON = ["current_test.go", "postgres_test.go", "runtime_test.go", "policy_test.go", "caller_test.go"]
DEPS = [
    "//internal/cli",
    "//internal/client",
    "//internal/core/authz",
    "//internal/plugins/authnapikey",
    "//internal/plugins/authzfixed",
    "//internal/server/authzrpc",
    "//internal/core/events",
    "//internal/core/model",
    "//internal/core/pipeline",
    "//internal/core/service",
    "//internal/server/events",
    "//internal/server/rpc",
    "//internal/server/watch",
    "//internal/server/watchhttp",
    "//internal/storage/driver",
    "//internal/storage/memory",
    "//internal/storage/postgres",
    "//internal/storage/sqlite",
]

go_test(
    name = "current_test",
    srcs = COMMON,
    args = ["-test.v"],
    deps = DEPS,
    size = "large",
    tags = ["local", "requires-network"],
    timeout = "long",
)

# Explicit public source-built reference recordings; no official producer action.
go_test(
    name = "record_native_test",
    srcs = COMMON + ["native_build_test.go", "native_recording_test.go"],
    data = ["//spec/s1-b09-native:lexicon_files", "//internal/publicnative:dolt_runtime"],
    env = {"PLUG_PINNED_DOLT_BINARY": "$(rlocationpath //internal/publicnative:dolt_runtime)"},
    args = ["-test.v", "-test.run=^TestB20FreshNativeCurrentWorkingSetTwins$$"],
    deps = DEPS + ["//internal/publicnative"],
    size = "enormous",
    tags = ["local", "manual"],
    timeout = "eternal",
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

# Reuse the unchanged canonical source-build recipe in card-specific targets.
filegroup(
    name = "native_build_support",
    srcs = ["native_build_test.go"],
    visibility = ["//visibility:public"],
)

# Card-specific B03 controls. Existing B20 targets/support remain unchanged.
B03_DEPS = [
    "//internal/core/model",
    "//internal/core/ontology",
    "//internal/core/ontologyops",
    "//internal/core/pipeline",
    "//internal/core/service",
    "//internal/server/ontologyrpc",
    "//internal/server/rpc",
    "//internal/server/transport/inprocess",
    "//internal/storage/conformance",
    "//internal/storage/driver",
    "//internal/storage/memory",
    "//internal/storage/postgres",
    "//internal/storage/sqlite",
]

go_test(
    name = "b03_catalog_controls_test",
    srcs = ["b03_catalog_controls_test.go", "postgres_test.go"],
    args = ["-test.v"],
    deps = B03_DEPS,
    size = "large",
    tags = ["local", "requires-network"],
    timeout = "long",
)

# Explicit canonical public operational recording; no official producer action.
# It pairs the actual source-built native CLI with ordinary Plug byte RPC.
go_test(
    name = "record_b03_catalog_test",
    srcs = [
        "b03_catalog_controls_test.go",
        "b03_catalog_recording_test.go",
        "native_build_test.go",
        "postgres_test.go",
    ],
    data = ["//spec/s1-b09-native:lexicon_files", "//internal/publicnative:dolt_runtime"],
    env = {"PLUG_PINNED_DOLT_BINARY": "$(rlocationpath //internal/publicnative:dolt_runtime)"},
    args = ["-test.v", "-test.run=^TestB03CanonicalNativeNonemptyCatalog$$"],
    deps = B03_DEPS + ["//internal/publicnative"],
    size = "enormous",
    tags = ["local", "manual", "requires-network"],
    timeout = "eternal",
)
