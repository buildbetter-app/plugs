load("@rules_go//go:def.bzl", "go_test")

COMMON = ["current_test.go", "postgres_test.go", "runtime_test.go", "policy_test.go", "caller_test.go", "sql_rows_test.go"]
DEPS = [
    "//internal/cli",
    "//internal/client",
    "//internal/core/authz",
    "//internal/plugins/authnapikey",
    "//internal/plugins/authzfixed",
    "//internal/server/authzrpc",
    "//internal/core/events",
    "//internal/core/model",
    "//internal/core/pipeline",
    "//internal/core/service",
    "//internal/server/events",
    "//internal/server/rpc",
    "//internal/server/watch",
    "//internal/server/watchhttp",
    "//internal/storage/driver",
    "//internal/storage/memory",
    "//internal/storage/postgres",
    "//internal/storage/sqlite",
]

go_test(
    name = "current_test",
    srcs = COMMON,
    args = ["-test.v"],
    deps = DEPS,
    size = "large",
    tags = ["local", "requires-network"],
    timeout = "long",
)

# Explicit public source-built reference recordings; no official producer action.
go_test(
    name = "record_native_test",
    srcs = COMMON + ["native_build_test.go", "native_recording_test.go"],
    data = ["//spec/s1-b09-native:lexicon_files", "//internal/publicnative:dolt_runtime"],
    env = {"PLUG_PINNED_DOLT_BINARY": "$(rlocationpath //internal/publicnative:dolt_runtime)"},
    args = ["-test.v", "-test.run=^TestB20FreshNativeCurrentWorkingSetTwins$$"],
    deps = DEPS + ["//internal/publicnative"],
    size = "enormous",
    tags = ["local", "manual"],
    timeout = "eternal",
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

# Reuse the unchanged canonical source-build recipe in card-specific targets.
filegroup(
    name = "native_build_support",
    srcs = ["native_build_test.go"],
    visibility = ["//visibility:public"],
)

# Reuse the existing public disposable PostgreSQL fixture without copying it.
filegroup(
    name = "native_postgres_support",
    srcs = ["postgres_test.go"],
    visibility = ["//visibility:public"],
)

# B02 owns these controls; existing B20 tests are compiled for unchanged store
# and native-command support but are not selected or rerun by either target.
B02_PUBLIC = ["b02_native_graph_test.go", "b02_public_graph_test.go"]
B02_DEPS = DEPS + [
    "//internal/core/ontology",
    "//internal/server/pluginhost",
    "//internal/storage/conformance",
    "//plugins/workflow",
]

go_test(
    name = "b02_public_blocking_test",
    srcs = COMMON + B02_PUBLIC,
    args = ["-test.v", "-test.run=^TestB02PublicBlockingAcrossStores$$"],
    deps = B02_DEPS,
    size = "large",
    tags = ["local", "requires-network"],
    timeout = "long",
)

go_test(
    name = "b02_native_blocking_test",
    srcs = COMMON + B02_PUBLIC + [":native_build_support", "native_recording_test.go", "b02_native_recording_test.go"],
    data = ["//spec/s1-b09-native:lexicon_files", "//internal/publicnative:dolt_runtime"],
    env = {"PLUG_PINNED_DOLT_BINARY": "$(rlocationpath //internal/publicnative:dolt_runtime)"},
    args = ["-test.v", "-test.run=^TestB02CanonicalNativeBlocking$$"],
    deps = B02_DEPS + ["//internal/publicnative"],
    size = "enormous",
    tags = ["local", "manual"],
    timeout = "eternal",
)
