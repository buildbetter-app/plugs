# Physical execution requires a separate, reviewed actual prepared-admission
# handoff. Ordinary focused/whole gates must not request this manual target.
go_test(
    name = "native_recording",
    srcs = [
        "fixture_test.go",
        "manifest_test.go",
        "native_io_test.go",
        "native_projection_test.go",
        "native_recording_test.go",
        "native_replay_test.go",
        "native_hierarchy_test.go",
        "native_membership_test.go",
        "native_parent_compatibility_test.go",
        "native_exclusion_test.go",
    ],
    embedsrcs = [
        "manifest.json",
        "native_inputs.json",
        "run-1.json",
    ],
    args = ["-test.v"],
    data = ["//internal/publicnative:dolt_runtime"],
    env = {
        "PLUG_PINNED_DOLT_BINARY": "$(rlocationpath //internal/publicnative:dolt_runtime)",
    },
    deps = [
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/service",
        "//internal/publicnative",
        "//internal/server/rpc",
        "//internal/server/transport/inprocess",
        "//internal/storage/conformance",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/postgres",
        "//internal/storage/sqlite",
        "//internal/testclock",
    ],
    tags = ["manual", "local", "requires-network"],
    shard_count = 2,
    timeout = "long",
)
