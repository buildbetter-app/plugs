load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "recorded_integrity_test",
    srcs = ["recorded_integrity_test.go"],
    embedsrcs = [
        "manifest.json",
        "record_reference.py",
        "run-1.json",
        "run-2.json",
    ],
    args = ["-test.v"],
)

go_test(
    name = "replay",
