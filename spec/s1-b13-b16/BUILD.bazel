load("@bazel_tools//tools/sh:sh.bzl", "sh_binary")
load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "acceptance",
    srcs = [
        "slice_test.go",
    ],
    embedsrcs = [
        "record_reference.py",
    ],
    args = ["-test.v"],
    deps = [
        "//internal/api/wire",
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/service",
        "//internal/server/rpc",
        "//internal/server/transport/inprocess",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/sqlite",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "reference_capture",
    srcs = ["reference_capture.py"],
    data = ["record_reference.py"],
)
