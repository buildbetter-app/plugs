load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "plugs",
    srcs = ["doc.go"],
    importpath = "github.com/buildbetter-app/plugs",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "lexicon_tree",
    # A checkout inventory crosses package and hidden-directory boundaries;
    # native globs and a list of known package targets cannot do that.
    srcs = [
        "//tools/lexicon/output_links:verified",
        "@lexicon_sources//:tree",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "lexicon_gate",
    tests = ["//tools/lexicon:lexicon_gate"],
    visibility = ["//visibility:public"],
)
