load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "plugs",
    srcs = ["doc.go"],
    importpath = "github.com/buildbetter-app/plugs",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "lexicon_tree",
    # Keep the root inventory complete as the skeleton grows. Bazel's * glob
    # includes dotfiles; the .git pointer is checkout metadata, not source.
    srcs = glob(["*"], exclude = ["BUILD.bazel", ".git", ".git/**"]) + [
        "BUILD.bazel",
        "//cmd/plug:lexicon_files",
        "//engdocs/style:lexicon_files",
        "//internal:lexicon_files",
        "//pluginapi:lexicon_files",
        "//sdk/go:lexicon_files",
        "//tools/lexicon:lexicon_files",
    ] + glob([
        ".github/**",
        "engdocs/adr/**",
        "engdocs/design/plug/**",
    ]),
    visibility = ["//visibility:public"],
)

test_suite(
    name = "lexicon_gate",
    tests = ["//tools/lexicon:lexicon_gate"],
    visibility = ["//visibility:public"],
)
