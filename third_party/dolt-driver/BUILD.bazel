        "@com_github_dolthub_vitess//go/vt/sqlparser",
        "@com_github_go_sql_driver_mysql//:mysql",
    ],
)

# manual: private boundary supplement, explicitly selected alongside physical fixtures.
go_test(
    name = "physical_commit_test",
    srcs = ["physical_commit_test.go", "physical_history_test.go"],
    deps = ["@com_github_dolthub_dolt_go//libraries/doltcore/doltdb"],
    embed = [":driver"],
    tags = ["manual"],
)

go_test(
    name = "driver_lint_test",
    srcs = ["landing_lint_test.go"],
    embed = [":driver"],
    gotags = ["gms_pure_go"],
)

