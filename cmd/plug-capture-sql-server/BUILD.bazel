load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "plug-capture-sql-server_lib",
    srcs = ["main.go"],
    importpath = "github.com/steveyegge/beads/cmd/plug-capture-sql-server",
    visibility = ["//visibility:private"],
    deps = ["//internal/storage/capturesqlserver"],
)

# A distinct capture companion. The normal pinned Dolt executable is unchanged.
go_binary(
    name = "plug-capture-sql-server",
    embed = [":plug-capture-sql-server_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "native_capture_test",
    size = "large",
    srcs = ["native_capture_test.go"],
    data = [
        ":plug-capture-sql-server",
        "//cmd/bd:bd",
    ],
    env = {
        "BEADS_CAPTURE_BD_BINARY": "$(rootpath //cmd/bd:bd)",
        "BEADS_CAPTURE_SQL_BINARY": "$(rootpath :plug-capture-sql-server)",
    },
    deps = [
        "//internal/captureclock",
        "//internal/plugdump",
        "//internal/testutil/bazeltest",
        "@com_github_go_sql_driver_mysql//:mysql",
    ],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

