load("@rules_go//go:def.bzl", "go_binary", "go_test")

go_binary(
    name = "plug",
    srcs = ["main.go"],
    importpath = "github.com/buildbetter-app/plugs/cmd/plug",
    visibility = ["//visibility:public"],
    deps = ["//internal/cli"],
)

go_test(
    name = "plug_test",
    srcs = ["i8_heartbeads_e2e_test.go", "i8_heartbeads_fixture_test.go", "integration_test.go", "remote_fixture_test.go", "remote_test.go", "server_integration_test.go"],
    args = ["-test.v"],
    data = [":plug"] + glob(["testdata/i8/**"]),
    env = {"I8_ADAPTER": "$(rootpath testdata/i8/plug-adapter.mjs)", "PLUG_BINARY": "$(rootpath :plug)"},
    deps = [
        "//internal/storage/sqlite",
        "//internal/storage/conformance",
        "//internal/core/restore",
        "//internal/core/ontology",
        "//internal/api/wire",
        "//internal/client",
        "//internal/core/model",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/core/service",
        "//internal/plugins/authnapikey",
        "//internal/server/authn",
        "//internal/server/rpc",
        "//internal/server/transport/httpjson",
        "//internal/server/transport/mcp",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "@org_modernc_sqlite//:sqlite",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
