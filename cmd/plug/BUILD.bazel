load("@rules_go//go:def.bzl", "go_binary", "go_test")

go_binary(
    name = "plug",
    srcs = ["main.go"],
    importpath = "github.com/buildbetter-app/plugs/cmd/plug",
    visibility = ["//visibility:public"],
    deps = ["//internal/cli"],
)

go_test(
    name = "plug_test",
    srcs = ["integration_test.go"],
    data = [":plug"],
    env = {"PLUG_BINARY": "$(rootpath :plug)"},
    deps = ["//internal/api/wire"],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
