-        assert target and target["type"] == "milestone", f"unknown milestone {item['milestone']}"
-for key in list(change.get("update", {})) + list(change.get("close", {})) + list(change.get("dep_add", {})):
-    assert key in known, f"unknown key {key}"
-for key, deps in change.get("dep_remove", {}).items():
-    for dep in deps:
-        assert dep in items[key]["deps"], f"{key} has no dep {dep}"
-for key, deps in change.get("dep_add", {}).items():
