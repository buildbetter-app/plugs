-shutil.copy(ids_path, f"{ids_path}.{stamp}.bak")
-
-
-def bd(*args):
-    result = subprocess.run(["bd", *args], capture_output=True, text=True)
-    if result.returncode != 0:
-        raise SystemExit(f"bd {' '.join(args[:3])} ... failed: {result.stderr.strip()[:500]}")
-    return result.stdout.strip()
-
-
-def footer(key, description):
-    return f"{description}\n\nPlan key: {key}. Design doc: {doc}"
-
-
-creates = change.get("create", [])
-known = set(items) | {item["key"] for item in creates}
-for item in creates:
-    assert item["key"] not in items, f"{item['key']} already exists"
