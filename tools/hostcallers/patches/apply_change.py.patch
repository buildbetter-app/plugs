-for key, deps in change.get("dep_add", {}).items():
-    for dep in deps:
-        bd("dep", "add", ids[key], "--blocked-by", ids[dep])
-        items[key]["deps"].append(dep)
-
-for item in creates:
-    milestone = item.get("milestone")
-    if milestone:
-        bd("label", "add", ids[item["key"]], f"milestone:{milestone.lower()}")
