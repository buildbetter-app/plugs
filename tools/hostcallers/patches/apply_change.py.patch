-"""Apply one change batch to the signals-v2 beads, plan.json and ids.json, and queue the matching Linear ops.
-
-Usage: python3 -I apply_change.py <workspace> <change.json>
-
-change.json keys (all optional):
-  create:     [{key, type, priority, parent, deps, labels?, title, description, milestone?}]
-  update:     {key: {title?, description?, priority?}}
-  dep_add:    {key: [dep keys]}
-  dep_remove: {key: [dep keys]}
-  move:       {key: milestone key}   (moves an item to another milestone)
-  reopen:     [keys]                  (runs before close, so a key can be reopened and closed with a new reason)
-  close:      {key: reason}
-Every batch is appended to <workspace>/linear-pending.json for the Linear mirror.
-"""
-import json, os, shutil, subprocess, sys, time
-
-workspace, change_path = sys.argv[1], sys.argv[2]
-plan_path = os.path.join(workspace, "plan.json")
-ids_path = os.path.join(workspace, "ids.json")
-pending_path = os.path.join(workspace, "linear-pending.json")
-plan = json.load(open(plan_path))
-ids = json.load(open(ids_path))
-change = json.load(open(change_path))
-items = {item["key"]: item for item in plan["items"]}
