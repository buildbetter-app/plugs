-    plan["items"].append(entry)
-    items[item["key"]] = entry
-    print("created", item["key"], ids[item["key"]])
-
-for key, fields in change.get("update", {}).items():
-    args = ["update", ids[key]]
-    if "title" in fields:
-        args += ["--title", fields["title"]]
-        items[key]["title"] = fields["title"]
-    if "description" in fields:
-        args += ["-d", footer(key, fields["description"])]
-        items[key]["description"] = fields["description"]
-    if "priority" in fields:
-        args += ["-p", str(fields["priority"])]
-        items[key]["priority"] = fields["priority"]
-    # ExecPlan fields: design (behavior, files, approach) and acceptance (commands, expected result, evidence).
-    if "design" in fields:
-        args += ["--design", fields["design"]]
-        items[key]["design"] = fields["design"]
-    if "acceptance" in fields:
-        args += ["--acceptance", fields["acceptance"]]
-        items[key]["acceptance"] = fields["acceptance"]
-    bd(*args)
-
-for key, deps in change.get("dep_remove", {}).items():
-    for dep in deps:
-        bd("dep", "remove", ids[key], ids[dep])
-        items[key]["deps"].remove(dep)
-for item in creates:
-    for dep in item.get("deps", []):
