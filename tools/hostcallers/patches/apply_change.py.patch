-
-json.dump(plan, open(plan_path, "w"), indent=2)
-json.dump(ids, open(ids_path, "w"), indent=2)
-
-pending = json.load(open(pending_path)) if os.path.exists(pending_path) else []
-pending.append({"applied_at": stamp, "change": change,
-                "beads": {item["key"]: ids[item["key"]] for item in creates}})
-json.dump(pending, open(pending_path, "w"), indent=2)
-print("applied", os.path.basename(change_path))
