-        assert not dep.startswith(key + "."), f"{key} cannot be blocked by its descendant {dep}"
-
-creates = sorted(creates, key=lambda i: i["type"] != "milestone")
-for item in creates:
-    labels = item.get("labels", [])
-    issue_type = "decision" if "decision" in labels else item["type"]
-    args = ["create", item["title"], "-t", issue_type, "-p", str(item["priority"]),
