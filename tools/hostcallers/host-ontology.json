{
  "statuses": {
    "open": {
      "name": "Open",
      "category": "unstarted"
    },
    "in_progress": {
      "name": "In progress",
      "category": "started"
    },
    "closed": {
      "name": "Closed",
      "category": "completed",
      "outcome": "success"
    },
    "deferred": {
      "name": "Deferred",
      "category": "backlog"
    },
    "blocked": {
      "name": "Blocked",
      "category": "unstarted"
    },
    "pinned": {
      "name": "Pinned",
      "category": "backlog"
    },
    "frozen": {
      "name": "Frozen",
      "category": "backlog"
    }
  },
  "workflows": {
    "host": {
      "statuses": [
        "open",
        "in_progress",
        "closed",
        "deferred",
        "blocked",
        "pinned",
        "frozen"
      ],
      "initial": "open",
      "slots": {
        "claim": "in_progress",
        "close": "closed",
        "reopen": "open",
        "defer": "deferred"
      },
      "transitions": [
        {
          "to": "closed",
          "guards": [
            {
              "kind": "not_template"
            },
            {
              "kind": "no_open_children"
            },
            {
              "kind": "no_open_blockers"
            },
            {
              "kind": "permission"
            }
          ]
        },
        {
          "to": "in_progress",
          "guards": [
            {
              "kind": "no_open_blockers"
            },
            {
              "kind": "permission"
            }
          ]
        },
        {
          "to": "open",
          "guards": [
            {
              "kind": "permission"
            }
          ]
        },
        {
          "to": "deferred",
          "guards": [
            {
              "kind": "permission"
            }
          ]
        }
      ]
    }
  },
