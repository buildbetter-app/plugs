load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "census",
    srcs = ["census.go"],
    importpath = "github.com/buildbetter-app/plugs/tools/census",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "census_check",
    srcs = ["cmd/census_check/main.go"],
    args = ["-census-fixture=$(rlocationpath //tools/census:testdata/census.json)"],
    data = ["//tools/census:testdata/census.json"],
    importpath = "github.com/buildbetter-app/plugs/tools/census/cmd/census_check",
    visibility = ["//visibility:public"],
    deps = [":census"],
)

go_test(
    name = "census_gate",
    srcs = ["gate_test.go"],
    args = ["-census-fixture=$(rlocationpath //tools/census:testdata/census.json)"],
    data = ["//tools/census:testdata/census.json"],
    embed = [":census"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "testdata",
    srcs = ["testdata/census.json"],
    visibility = ["//visibility:public"],
)
