load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "census",
    srcs = [
        "behavior.go",
        "census.go",
        "command.go",
        "measure.go",
        "paired.go",
    ],
    importpath = "github.com/buildbetter-app/plugs/tools/census",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/dumpformat",
        "//internal/core/model",
        "//internal/core/pipeline",
        "//internal/storage/driver",
    ],
)

go_binary(
    name = "paired_census",
    srcs = ["cmd/paired_census/main.go"],
    importpath = "github.com/buildbetter-app/plugs/tools/census/cmd/paired_census",
    visibility = ["//visibility:public"],
    deps = [":census"],
)

go_test(
    name = "paired_census_test",
    srcs = [
        "measure_test.go",
        "paired_test.go",
    ],
    args = ["-dump-fixture=$(rlocationpath //internal/integration/converterroundtrip:testdata/synthetic-plug-dump-1.tar)"],
    data = [
        "//:lexicon_tree",
        "//internal/integration/converterroundtrip:testdata/synthetic-plug-dump-1.tar",
    ],
    embed = [":census"],
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/model",
        "//internal/core/pipeline",
        "//internal/core/service",
        "//internal/integration/converterroundtrip",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/sqlite",
    ],
)

go_binary(
    name = "census_check",
    srcs = ["cmd/census_check/main.go"],
    args = ["-census-fixture=$(rlocationpath //tools/census:testdata/census.json)"],
    data = ["//tools/census:testdata/census.json"],
    importpath = "github.com/buildbetter-app/plugs/tools/census/cmd/census_check",
    visibility = ["//visibility:public"],
    deps = [":census"],
)

go_test(
    name = "census_gate",
    srcs = ["gate_test.go"],
    args = ["-census-fixture=$(rlocationpath //tools/census:testdata/census.json)"],
    data = ["//tools/census:testdata/census.json"],
    embed = [":census"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "testdata",
    srcs = ["testdata/census.json"],
    visibility = ["//visibility:public"],
)
