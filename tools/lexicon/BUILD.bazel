load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "checker",
    srcs = ["checker.go"],
    importpath = "github.com/buildbetter-app/plugs/tools/lexicon",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "lexicon_check",
