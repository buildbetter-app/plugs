load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "checker",
    srcs = [
        "b02_recording_literals.go",
        "b07_effect_literals.go",
        "b07_native_protocol_literals.go",
        "b07_represented_literals.go",
        "b24_recorded_timer_references.go",
        "checker.go",
        "config.go",
        "inventory.go",
        "native_undo.go",
        "native_undo_bindings.go",
        "native_undo_references.go",
        "policy.go",
        "rules.go",
    ],
    embedsrcs = glob(["rules.d/*.toml"]),
    importpath = "github.com/buildbetter-app/plugs/tools/lexicon",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "lexicon_check",
    srcs = ["cmd/lexicon_check/main.go"],
    data = [":rule_files"],
    importpath = "github.com/buildbetter-app/plugs/tools/lexicon/cmd/lexicon_check",
    visibility = ["//visibility:public"],
    deps = [":checker"],
)

go_test(
    name = "checker_test",
    srcs = [
        "b02_recording_literals_test.go",
        "b07_effect_literals_test.go",
        "b07_native_protocol_literals_test.go",
        "b07_represented_literals_test.go",
        "b24_recorded_timer_references_test.go",
        "checker_test.go",
        "config_test.go",
        "inventory_test.go",
        "native_undo_test.go",
    ],
    args = ["-undo-source-inventory=$(rlocationpath @lexicon_sources//:source_inventory.json)"],
    data = [
        ":rule_files",
        "//tools/roundtrip:readback_reference_fixtures",
        "//:lexicon_tree",
        "@lexicon_sources//:source_inventory.json",
    ],
    embed = [":checker"],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

go_test(
    name = "lexicon_gate",
    srcs = ["gate_test.go"],
    args = ["-lexicon-source-inventory=$(rlocationpath @lexicon_sources//:source_inventory.json)"],
    data = [
        "//:lexicon_tree",
        "@lexicon_sources//:source_inventory.json",
    ],
    embed = [":checker"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "rule_files",
    srcs = glob(["rules.d/*.toml"]),
)
