# The guarded manual entry defaults to three Full cases. The merged receiver
# is present; the extra mode opt-in requires exact-case native input proof.
go_test(
    name = "fresh_same_run_native_test",
    size = "enormous",
    timeout = "eternal",
    srcs = ["main.go", "beads.go", "beads_refusal.go", "beads_typed.go", "beads_fresh.go", "beads_fresh_inputs.go", "beads_fresh_archive.go", "beads_fresh_id.go", "beads_runtime_test.go", "beads_native_regression_test.go", "beads_typed_runtime_test.go", "beads_fresh_runtime_test.go", "beads_fresh_server_runtime_test.go", "beads_fresh_record_runtime_test.go", "beads_fresh_compose_runtime_test.go"],
    args = ["-test.run=^TestFreshSameRunIDStyleATwelveFixtures$$"],
    data = [
        "testdata/public-companion-profile.json",
        "testdata/fresh-native/recipe-profile.json",
        "testdata/fresh-native/continuation-fields.json",
        "testdata/fresh-native/beads-1a75f7.tar.gz",
        "testdata/fresh-native/beads-1a75f7.git-tree",
        "testdata/fresh-native/independent-row-replay.tar.gz",
        "fresh_oracle.py",
        "//internal/integration/converterroundtrip:converterroundtrip_test",
        "testdata/fresh-native/beads-ef3f15.tar.gz",
        "testdata/fresh-native/beads-ef3f15.git-tree",
        "testdata/typed-reader/beads-e25cf4.tar.gz",
        "testdata/typed-reader/beads-e25cf4.git-tree",
        "//internal/publicnative:dolt_runtime",
        "//internal/integration/offlinehistory:lexicon_files",
    ] + ["testdata/fresh-native/id-style-a-inputs.tar.gz", "testdata/fresh-native/id-style-a-inputs.provenance.json"],
    env = {
        "PLUG_PINNED_DOLT_BINARY": "$(rlocationpath //internal/publicnative:dolt_runtime)",
        "PLUG_ID_STYLE_A_CONSUMER": "$(rlocationpath //internal/integration/converterroundtrip:converterroundtrip_test)",
    },
    env_inherit = ["BAZEL_BIN", "BAZEL_RC", "BAZELISK_HOME", "BAZELISK_VERIFY_SHA256", "GITHUB_RUN_ID", "GITHUB_RUN_ATTEMPT", "GITHUB_SHA", "GITHUB_WORKFLOW_REF"],
    tags = ["local", "manual", "requires-network"],
    deps = _DEPS + ["//internal/publicnative", "@com_github_go_sql_driver_mysql//:mysql"],
)

