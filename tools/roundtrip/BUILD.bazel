load("@rules_go//go:def.bzl", "go_binary", "go_test")

_DEPS = [
    "//internal/core/dumpformat",
    "//internal/core/model",
    "//internal/core/pipeline",
    "//internal/core/reverseconverter",
    "//internal/core/service",
    "//internal/integration/converterroundtrip",
    "//internal/storage/driver",
    "//internal/storage/memory",
    "//internal/storage/postgres",
    "//internal/storage/sqlite",
]

filegroup(
    name = "readback_reference_fixtures",
    srcs = [
        "testdata/typed-reader/beads-e25cf4.tar.gz",
        "testdata/typed-reader/beads-e25cf4.git-tree",
        "testdata/readback-8f19/memory-complete-beads-raw-readback.tar",
        "testdata/readback-8f19/memory-complete-reverse-live.jsonl",
        "testdata/readback-8f19/memory-partial-beads-raw-readback.tar",
        "testdata/readback-8f19/memory-partial-reverse-live.jsonl",
    ],
    visibility = ["//tools/lexicon:__pkg__"],
)

go_binary(
    name = "roundtrip",
    srcs = ["main.go", "beads.go", "beads_refusal.go"],
    importpath = "github.com/buildbetter-app/plugs/tools/roundtrip",
    visibility = ["//visibility:public"],
    deps = _DEPS,
)

go_test(
    name = "roundtrip_test",
    size = "large",
    tags = ["local", "requires-network"],
    srcs = ["main.go", "beads.go", "beads_refusal.go", "beads_typed.go", "main_test.go", "beads_test.go", "beads_refusal_test.go", "beads_typed_test.go"],
    data = [
        "//internal/integration/converterroundtrip:public_source_fixtures",
        "//internal/integration/offlinehistory:lexicon_files",
    ] + glob(["testdata/readback-8f19/*"]),
    deps = _DEPS,
)

go_test(
    name = "public_beads_runtime_test",
    size = "enormous",
    timeout = "eternal",
    srcs = ["main.go", "beads.go", "beads_refusal.go", "beads_typed.go", "beads_runtime_test.go", "beads_native_regression_test.go", "beads_typed_runtime_test.go"],
    args = ["-public-beads-runtime"],
    data = [
        "testdata/public-companion-profile.json",
        "testdata/typed-reader/beads-e25cf4.tar.gz",
        "testdata/typed-reader/beads-e25cf4.git-tree",
        "//spec/s1-b25-b28:public_recording_protocol",
        "//spec/s1-b09-native:public_capture_source",
        "//internal/integration/converterroundtrip:public_source_fixtures",
        "//internal/integration/offlinehistory:lexicon_files",
    ],
    tags = ["local", "manual", "requires-network"],
    env_inherit = ["BAZEL_BIN", "BAZEL_RC", "BAZELISK_HOME", "BAZELISK_VERIFY_SHA256", "GITHUB_RUN_ID"],
    deps = _DEPS + ["//internal/publicnative"],
)
