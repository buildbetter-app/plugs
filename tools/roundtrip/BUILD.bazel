load("@rules_go//go:def.bzl", "go_binary", "go_test")

_DEPS = [
    "//internal/core/dumpformat",
    "//internal/core/model",
    "//internal/core/pipeline",
    "//internal/core/reverseconverter",
    "//internal/core/service",
    "//internal/integration/converterroundtrip",
    "//internal/storage/driver",
    "//internal/storage/memory",
    "//internal/storage/postgres",
    "//internal/storage/sqlite",
]

go_binary(
    name = "roundtrip",
    srcs = ["main.go", "beads.go"],
    importpath = "github.com/buildbetter-app/plugs/tools/roundtrip",
    visibility = ["//visibility:public"],
    deps = _DEPS,
)

go_test(
    name = "roundtrip_test",
    size = "large",
    tags = ["local", "requires-network"],
    srcs = ["main.go", "beads.go", "main_test.go", "beads_test.go", "beads_inventory_refusal_test.go"],
    data = [
        "//internal/integration/converterroundtrip:public_source_fixtures",
        "//internal/integration/offlinehistory:lexicon_files",
    ],
    deps = _DEPS,
)

go_test(
    name = "public_beads_runtime_test",
    size = "large",
    srcs = ["main.go", "beads.go", "beads_runtime_test.go", "beads_native_regression_test.go"],
    args = ["-public-beads-runtime"],
    data = [
        "testdata/native-public-profile.json",
        "testdata/native-public-recording-fixture.json",
        "//internal/integration/converterroundtrip:public_source_fixtures",
        "//internal/integration/offlinehistory:lexicon_files",
    ],
    tags = ["local", "manual", "requires-network"],
    deps = _DEPS,
)
