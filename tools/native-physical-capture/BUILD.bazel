load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "native-physical-capture_lib",
    srcs = ["diagnostic_contract.go", "diagnostics.go", "main.go", "native_delta.go", "physical_evidence.go", "history_probe.go"],
    importpath = "github.com/steveyegge/beads/tools/native-physical-capture",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/formula",
        "//internal/plugdump",
        "//internal/storage/physicalcapture",
        "@com_github_go_sql_driver_mysql//:mysql",
    ],
)

# manual: capture executable is built by its explicitly selected public controls.
go_binary(
    name = "native-physical-capture",
    embed = [":native-physical-capture_lib"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "safe_diagnostics_test",
    size = "large",
    srcs = ["diagnostics_test.go", "schema_probe_test.go", "own_version_test.go", "native_delta_test.go", "commit_diagnostics_test.go", "commit_history_test.go", "history_boundary_test.go", "history_probe_test.go", "chunk_archive_history_test.go", "row_chunk_history_test.go"],
    data = [":native-physical-capture"],
    embed = [":native-physical-capture_lib"],
    env = {"BEADS_PHYSICAL_CAPTURE_BINARY": "$(rootpath :native-physical-capture)"},
    deps = [
        "//internal/plugdump",
        "//internal/storage/physicalcapture",
        "//internal/storage/schema",
        "//internal/storage/versioncontrolops",
        "//internal/testutil/bazeltest",
        "@com_github_dolthub_dolt_go//libraries/doltcore/doltdb",
        "@com_github_dolthub_dolt_go//libraries/doltcore/doltdb/durable",
        "@com_github_dolthub_dolt_go//libraries/doltcore/env",
