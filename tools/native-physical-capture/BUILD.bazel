load("@rules_go//go:def.bzl", "go_binary", "go_library")

# manual: GMS compiles through gms_pure_go test/binary transitions, including nogo.
go_library(
    name = "native-physical-capture_lib",
    tags = ["manual"],
    srcs = ["main.go"],
    importpath = "github.com/steveyegge/beads/tools/native-physical-capture",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/formula",
        "//internal/plugdump",
        "//internal/storage/physicalcapture",
    ],
)

go_binary(
    name = "native-physical-capture",
    gotags = ["gms_pure_go"],
    embed = [":native-physical-capture_lib"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

