{
  "manifest_version": 1,
  "plugins": [{
    "id": "buildbetter.workflow",
    "alias": "workflow",
    "version": "1.0.0",
    "plugin_api": "1.0",
    "runtime": "native",
    "requires": {"state": "durable"},
    "provides": [{
      "kind": "methods",
      "prefix": "x.workflow",
      "methods": {
        "invoke": {"permission": "write", "resource": "params.project"},
        "run.promote": {"permission": "write", "resource": "params.target"},
        "run.demote": {"permission": "write", "resource": "params.source"}
      }
    }]
  }]
}
