load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "authnoidc",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/buildbetter-app/plugs/internal/plugins/authnoidc",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/api/wire",
        "//internal/core/model",
        "//internal/server/authn",
    ],
)

go_test(
    name = "authnoidc_test",
    srcs = glob(["*_test.go"]),
    embed = [":authnoidc"],
    deps = [
        "//internal/core/model",
        "//internal/server/authn",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
