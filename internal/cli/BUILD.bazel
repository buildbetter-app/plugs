load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cli",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/buildbetter-app/plugs/internal/cli",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/api/wire",
        "//internal/client",
    ],
)

go_test(
    name = "cli_test",
    srcs = glob(["*_test.go"]),
    embed = [":cli"],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
