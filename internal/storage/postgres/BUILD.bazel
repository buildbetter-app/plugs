load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "postgres",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/buildbetter-app/plugs/internal/storage/postgres",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/core/model",
        "//internal/storage/driver",
        "//internal/storage/sourceindex",
        "@com_github_jackc_pgx_v5//stdlib:stdlib",
    ],
)

go_test(
    name = "postgres_test",
    srcs = glob(["*_test.go"]),
    embed = [":postgres"],
    deps = [
        "//internal/core/model",
        "//internal/core/pipeline:pipeline",
        "//internal/core/port",
        "//internal/storage/driver",
        "//internal/storage/sourceindex",
        "//internal/storage/conformance",
        "//internal/storage/conformance/sourceactivation",
        "//internal/testclock",
    ],
    size = "large",
    tags = ["exclusive", "local", "requires-network"],
)
