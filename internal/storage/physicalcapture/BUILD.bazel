load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "physicalcapture",
    srcs = ["capture.go", "diagnostics.go", "evidence.go", "working.go"],
    importpath = "github.com/steveyegge/beads/internal/storage/physicalcapture",
    visibility = ["//:__subpackages__"],
    deps = ["@com_github_dolthub_driver_v2//:driver"],
)

go_test(
    name = "working_root_test",
    size = "large",
    srcs = ["evidence_test.go", "working_test.go"],
    gotags = ["gms_pure_go"],
    deps = [
        ":physicalcapture",
        "//internal/storage/schema",
        "//internal/storage/versioncontrolops",
        "@com_github_dolthub_driver_v2//:driver",
    ],
)

