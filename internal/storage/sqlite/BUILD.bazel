load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sqlite",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/buildbetter-app/plugs/internal/storage/sqlite",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/core/model",
        "//internal/storage/driver",
        "//internal/storage/readyindex",
        "//internal/storage/sourceindex",
        "@org_modernc_sqlite//:sqlite",
    ],
)

go_test(
    name = "sqlite_test",
    # Restores 20,000-bead fixtures; isolate from parallel load like the other heavy targets (#272, #283).
    tags = ["exclusive"],
    srcs = glob(["*_test.go"]),
    embed = [":sqlite"],
    deps = [
        "//internal/core/dumpformat",
        "//internal/core/model",
        "//internal/core/pipeline",
        "//internal/core/restore",
        "//internal/core/service",
        "//internal/storage/conformance",
        "//internal/storage/conformance/sourceactivation",
        "//internal/storage/memory",
        "//internal/testclock",
        "//internal/storage/driver",
        "//internal/storage/sourceindex",
    ],
)
