{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plug-dump:1:beads-head-archive:manifest:1",
  "title": "Beads offline-head-and-source-archives manifest",
  "description": "Archive integrity schema. Capture, SQL definitions, A6 history and Plug restore remain explicitly unverified. Executable validation also checks member and registry consistency.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema", "beads_reference", "store_id", "machine", "main_version", "ignored_version", "scope", "history", "projects", "kind_registry", "files", "sources", "warnings", "verification"],
  "properties": {
	"native_history_contract": {"const":"beads-native-delta/2"},
    "format": {"const": "plug-dump/1"},
    "schema": {"const": 1},
    "beads_reference": {"const": "9d6fff760b7a314b476539198504d77ce0959656"},
    "store_id": {"type": "string", "minLength": 1},
    "machine": {"type": "string", "minLength": 1},
    "main_version": {"enum": [66, 72]},
    "ignored_version": {"enum": [26, 28]},
    "scope": {"const": "offline-head-and-source-archives"},
    "history": {"enum": ["unavailable", "available-unverified", "verified"]},
    "source_fields_contract": {"const": "beads-issues-source-fields/1"},
    "source_plane_address_contract": {"const": "beads-source-planes/1"},
    "source_family_contract": {"const": "beads-source-families/1"},
    "status_category_contract": {"const": "beads-status-categories/1"},
    "projects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/project"}},
    "ontology": {"type": "array", "items": {"$ref": "#/$defs/ontologyDirective"}},
    "kind_registry": {"type": "array", "items": {"$ref": "#/$defs/kind"}},
    "files": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/file"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "warnings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture", "schema", "history", "a3", "authz.verify", "derived", "plugin_lock", "ontology"],
      "properties": {
        "capture": {"const": "operator declarations; freeze/remotes/working-set not independently verified"},
        "schema": {"const": "paired migration hashes and exact column names; SQL types, indexes and constraints not independently verified"},
        "history": {"const": "available source rows archived only; no A6 replay or completeness claim"},
        "a3": {"const": "not-run"},
        "authz.verify": {"const": "not-run"},
        "derived": {"const": "not-run"},
        "plugin_lock": {"const": "not-produced"},
        "ontology": {"enum": ["built-in status mapping; explicit map_type directives recorded in manifest", "native status names/categories retained per project; explicit map_type directives recorded in manifest"]}
      }
    }
  },
  "allOf": [{"if":{"required":["status_category_contract"]},"then":{"properties":{"projects":{"items":{"required":["statuses"]}},"verification":{"properties":{"ontology":{"const":"native status names/categories retained per project; explicit map_type directives recorded in manifest"}}}}},"else":{"properties":{"projects":{"items":{"not":{"required":["statuses"]}}},"verification":{"properties":{"ontology":{"const":"built-in status mapping; explicit map_type directives recorded in manifest"}}}}}},{"if":{"required":["source_family_contract"]},"then":{"required":["source_plane_address_contract"]},"else":{"properties":{"sources":{"items":{"not":{"required":["history"]}}}}}},{"if":{"properties":{"main_version":{"const":66}}},"then":{"required":["source_family_contract"],"properties":{"ignored_version":{"const":26},"source_family_contract":{"const":"beads-source-families/1"}}},"else":{"properties":{"ignored_version":{"const":28}}}}],
  "$defs": {
    "projectStatus": {"type":"object","additionalProperties":false,"required":["name","category"],"properties":{"name":{"type":"string","maxLength":64,"pattern":"^[a-z][a-z0-9_-]*$"},"category":{"enum":["active","wip","done","frozen"]}}},
    "natural": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "id_mode", "hash_length", "last_id", "child_counters"],
      "properties": {
        "prefix": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,31}$"},
        "id_mode": {"enum": ["hash", "sequential"]},
        "hash_length": {"type": "integer", "minimum": 0, "maximum": 64},
        "statuses": {"type":"array","minItems":7,"maxItems":57,"items":{"$ref":"#/$defs/projectStatus"}},
        "hash_namespaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 32, "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(-[a-zA-Z0-9_]+)*$"}},
        "last_id": {"$ref": "#/$defs/natural"},
        "child_counters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/natural"}}
      },
      "allOf": [
        {"if": {"properties": {"id_mode": {"const": "hash"}}}, "then": {"properties": {"hash_length": {"minimum": 1}}}},
        {"if": {"required": ["hash_namespaces"]}, "then": {"properties": {"id_mode": {"const": "hash"}}}}
      ]
    },
    "ontologyTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "type"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "ontologyDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "target", "from", "to"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "map_type"},
        "target": {"$ref": "#/$defs/ontologyTarget"},
        "from": {"type": "string", "minLength": 1},
        "to": {"const": "issue"}
      }
    },
    "kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "file", "count"],
      "properties": {
        "name": {"enum": ["bead", "edge", "comment", "memory", "config", "beads-archive"]},
        "version": {"enum": [1, 2, 3]},
        "file": {"type": "string", "pattern": "^records/(bead|edge|comment|memory|config|beads-archive)\\.ndjson$"},
        "count": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {"if": {"properties": {"name": {"const": "edge"}}}, "then": {"properties": {"version": {"enum": [1, 2, 3]}}}, "else": {"properties": {"version": {"const": 1}}}}
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0, "maximum": 134217728}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "rows", "action", "reason"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "rows": {"type": "integer", "minimum": 0},
        "action": {"enum": ["carry", "archive", "manifest/rebuild", "refuse-if-nonempty"]},
        "reason": {"type": "string", "minLength": 1},
        "history": {"enum": ["versioned", "unversioned-in-beads-by-design"]}
      }
    }
  }
}
