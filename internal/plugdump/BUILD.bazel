load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "plugdump",
    srcs = [
        "native_clock.go",
        "archive.go",
        "build.go",
        "catalog.go",
        "identity.go",
        "map.go",
        "migration_hashes.go",
        "native_inventory.go",
        "read.go",
        "source_history.go",
        "source_history_sql.go",
        "source_history_wire.go",
        "source_planes.go",
        "types.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/plugdump",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/captureclock",
        "//internal/config",
        "//internal/storage/issueops",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "plugdump_test",
    srcs = [
        "native_clock_test.go",
        "native_inventory_test.go",
        "identity_test.go",
        "plugdump_test.go",
        "source_history_sql_test.go",
        "source_history_test.go",
        "source_planes_test.go",
    ],
    data = ["manifest.schema.json"] + glob(["testdata/**"]),
    embed = [":plugdump"],
    deps = [
        "//internal/captureclock",
        "//internal/testutil",
        "@com_github_data_dog_go_sqlmock//:go-sqlmock",
        "@com_github_go_sql_driver_mysql//:mysql",
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
    ],
)

filegroup(
    name = "synthetic_source",
    srcs = ["testdata/source.json"],
    visibility = ["//cmd/bd:__pkg__"],
)

filegroup(
    name = "synthetic_inventory",
    srcs = ["testdata/inventory.json"],
    visibility = ["//cmd/bd:__pkg__"],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
