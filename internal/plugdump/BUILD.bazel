load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "plugdump",
    srcs = [
        "archive.go",
        "build.go",
        "catalog.go",
        "map.go",
        "migration_hashes.go",
        "read.go",
        "types.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/plugdump",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/config"],
)

go_test(
    name = "plugdump_test",
    srcs = ["plugdump_test.go", "source_history_test.go"],
    data = glob(["testdata/**"]),
    embed = [":plugdump"],
)

filegroup(
    name = "synthetic_source",
    srcs = ["testdata/source.json"],
    visibility = ["//cmd/bd:__pkg__"],
)

filegroup(
    name = "synthetic_inventory",
    srcs = ["testdata/inventory.json"],
    visibility = ["//cmd/bd:__pkg__"],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
