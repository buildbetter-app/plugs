{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:beads-native-tables:1",
  "title": "Exact retained native table evidence; separate from portable replay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "store_id",
    "projects",
    "head",
    "commits",
    "ignore",
    "current",
    "images",
    "complete",
    "gaps"
  ],
  "properties": {
    "format": {
      "const": "beads-native-tables/1"
    },
    "store_id": {
      "type": "string",
      "minLength": 1
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "head": {
      "$ref": "#/$defs/commitID"
    },
    "commits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parents",
          "metadata"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/commitID"
          },
          "parents": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/commitID"
            }
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "ignore": {
      "$ref": "#/$defs/table"
    },
    "current": {
      "$ref": "#/$defs/tables"
    },
    "images": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "commit_id",
          "tables"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "commit_id": {
            "$ref": "#/$defs/commitID"
          },
          "tables": {
            "$ref": "#/$defs/tables"
          },
          "schema_profile": {
            "$ref": "#/$defs/commitSchemaProfile"
          }
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "gaps": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "commit_id",
          "reason"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "commit_id": {
            "$ref": "#/$defs/commitID"
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "schema_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_version",
        "ignored_version",
        "absences"
      ],
      "properties": {
        "main_version": {
          "enum": [
            66,
            72
          ]
        },
        "ignored_version": {
          "enum": [
            26,
            28
          ]
        },
        "absences": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family",
              "introduced_in",
              "reason"
            ],
            "properties": {
              "family": {
                "enum": [
                  "epoch_minted_addresses",
                  "issue_versions",
                  "issues",
                  "store_epoch",
                  "wisps"
                ]
              },
              "column": {
                "enum": [
                  "current_revision",
                  "participation_generation"
                ]
              },
              "introduced_in": {
                "enum": [
                  67,
                  70,
                  72
                ]
              },
              "reason": {
                "const": "absent-by-source-schema"
              }
            }
          }
        }
      }
    },
    "history_coverage": {
      "$ref": "#/$defs/historyCoverage"
    }
  },
  "$defs": {
    "commitID": {
      "type": "string",
      "pattern": "^[0-9a-v]{32}$"
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "rows"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,127}$"
          },
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "tables": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/table"
      }
    },
    "commitSchemaProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "scope",
        "main_version",
        "ignored_version",
        "absences"
      ],
      "properties": {
        "format": {
          "const": "beads-commit-schema/1"
        },
        "scope": {
          "const": "immutable-commit-root"
        },
        "main_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ignored_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "absences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family",
              "reason"
            ],
            "properties": {
              "family": {
                "type": "string"
              },
              "column": {
                "type": "string"
              },
              "reason": {
                "const": "absent-by-source-schema"
              }
            }
          }
        }
      }
    },
    "historyCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "status",
        "verified_commit_count",
        "boundaries",
        "events_attachment"
      ],
      "properties": {
        "format": {
          "const": "beads-native-history-coverage/1"
        },
        "status": {
          "const": "verified-to-boundary"
        },
        "verified_commit_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/historyBoundary"
          }
        },
        "events_attachment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "member",
            "sha256",
            "rows"
          ],
          "properties": {
            "member": {
              "const": "history/source.json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "rows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          }
        }
      }
    },
    "historyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_id",
        "child_commit_ids",
        "commit_ordinal_from_head",
        "reason"
      ],
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/commitID"
        },
        "child_commit_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/commitID"
          }
        },
        "commit_ordinal_from_head": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20000
        },
        "commit_schema_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "reason": {
          "enum": [
            "ghost_parent",
            "missing_root_chunk",
            "missing_table_chunk",
            "unreadable_schema",
            "other"
          ]
        },
        "sql_dolt_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "history_coverage"
        ]
      },
      "then": {
        "properties": {
          "complete": {
            "const": false
          },
          "gaps": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
