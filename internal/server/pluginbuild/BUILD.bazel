load("@rules_go//go:def.bzl", "go_library", "go_test")
load(":test_sdk.bzl", "test_go_sdk")

test_go_sdk(
    name = "test_go_sdk",
    testonly = True,
)

go_library(
    name = "pluginbuild",
    srcs = [
        "build.go",
        "containment_linux_amd64.go",
        "containment_other.go",
        "persistent.go",
        "process_other.go",
        "process_unix.go",
        "store.go",
    ],
    importpath = "github.com/buildbetter-app/plugs/internal/server/pluginbuild",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/server/pluginhost",
        "//internal/server/pluginmanifest",
        "//pluginapi",
        "//sdk/go:sdk_go",
        "@org_golang_x_sys//unix",
    ],
)

go_test(
    name = "pluginbuild_test",
    srcs = [
        "configured_browser_test.go",
        "containment_linux_amd64_test.go",
        "containment_other_test.go",
        "durable_test.go",
        "sdk_test.go",
        "source_test.go",
    ],
    data = [":test_go_sdk"],
    embedsrcs = [
        "//internal/server/pluginbuild/fixture:sources",
        "//internal/server/pluginbuild/fixture-wasi:sources",
    ],
    embed = [":pluginbuild"],
    env = {"PLUG_TEST_GO_BINARY": "$(rlocationpath :test_go_sdk)"},
    env_inherit = ["PATH"],
    deps = [
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/core/service",
        "//internal/server/composition",
        "//internal/server/pluginhost",
        "//internal/server/pluginmanifest",
        "//internal/server/transport/httpjson",
        "//internal/server/webui",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/sqlite",
        "//pluginapi",
        "//sdk/go:sdk_go",
        "@com_github_tetratelabs_wazero//:wazero",
        "@com_github_tetratelabs_wazero//sys",
        "@org_golang_x_sys//unix",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
