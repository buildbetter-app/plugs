load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "watch",
    srcs = ["authorization.go", "manager.go", "types.go"],
    importpath = "github.com/buildbetter-app/plugs/internal/server/watch",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/core/events",
        "//internal/core/model",
        "//internal/server/events",
    ],
)

go_test(
    name = "watch_test",
    srcs = glob(["*_test.go"], allow_empty = True),
    embed = [":watch"],
    deps = [
        "//internal/core/events",
        "//internal/core/model",
        "//internal/server/events",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/service",
        "//internal/storage/conformance",
        "//internal/storage/driver",
        "//internal/storage/memory",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
