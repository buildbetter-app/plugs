load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "viewrpc",
    srcs = ["bind.go", "cursor.go", "epic_progress.go"],
    importpath = "github.com/buildbetter-app/plugs/internal/server/viewrpc",
    visibility = [
        "//internal:__subpackages__",
        "//spec/cardb24:__pkg__",
        "//spec/s1-b21-b24:__pkg__",
    ],
    deps = [
        "//internal/api/wire",
        "//internal/core/model",
        "//internal/core/service",
        "//internal/core/viewops",
        "//internal/server/authzrpc",
        "//internal/server/rpc",
        "//internal/storage/driver",
    ],
)

go_test(
    name = "viewrpc_test",
    srcs = glob(["*_test.go"]),
    embed = [":viewrpc"],
    tags = ["exclusive"],
    deps = [
        "//internal/api/wire",
        "//internal/core/events",
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/service",
        "//internal/core/viewops",
        "//internal/server/rpc",
        "//internal/server/transport/inprocess",
        "//internal/storage/conformance",
        "//internal/storage/driver",
        "//internal/storage/memory",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
