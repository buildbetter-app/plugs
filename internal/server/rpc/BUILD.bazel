load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "rpc",
    srcs = ["cursor.go", "registry.go", "server.go", "service.go"],
    importpath = "github.com/buildbetter-app/plugs/internal/server/rpc",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/api/wire", "//internal/core/model", "//internal/core/port", "//internal/core/service"],
)

go_test(
    name = "rpc_test",
    srcs = ["cursor_test.go", "integration_test.go", "openrpc_test.go", "rpc_test.go"],
    embedsrcs = ["openrpc.json"],
    deps = [
        ":rpc",
        "//internal/api/wire",
        "//internal/core/model",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/core/service",
        "//internal/server/transport/inprocess",
        "//internal/storage/driver",
        "//internal/storage/memory",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
