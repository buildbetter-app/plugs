load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "rpc",
    srcs = ["admin.go", "cursor.go", "cycles.go", "registry.go", "server.go", "service.go"],
    importpath = "github.com/buildbetter-app/plugs/internal/server/rpc",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/api/wire", "//internal/core/model", "//internal/core/port", "//internal/core/restore", "//internal/core/service", "//internal/server/authn", "//internal/storage/driver"],
)

go_test(
    name = "rpc_test",
    srcs = ["cursor_test.go", "gate_integration_test.go", "integration_test.go", "openrpc_test.go", "rpc_test.go"],
    embedsrcs = ["openrpc.json"],
    deps = [
        ":rpc",
        "//internal/api/wire",
        "//internal/core/authz",
        "//internal/plugins/authnapikey",
        "//internal/plugins/authzfixed",
        "//internal/server/authzrpc",
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/core/service",
        "//internal/server/transport/inprocess",
        "//internal/storage/conformance",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/sqlite",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
