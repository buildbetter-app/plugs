load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "events",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/buildbetter-app/plugs/internal/server/events",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/core/events", "//internal/core/model", "//internal/storage/driver"],
)

go_test(
    name = "events_test",
    srcs = glob(["*_test.go"]),
    embed = [":events"],
    deps = ["//internal/core/events", "//internal/core/model", "//internal/core/pipeline", "//internal/core/port", "//internal/core/service", "//internal/storage/conformance", "//internal/storage/driver", "//internal/storage/memory", "//internal/storage/sqlite"],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
