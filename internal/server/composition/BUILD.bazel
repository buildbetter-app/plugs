load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "composition",
    srcs = ["config.go", "configfile.go"],
    importpath = "github.com/buildbetter-app/plugs/internal/server/composition",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/core/events",
        "//internal/core/model",
        "//internal/core/pipeline",
        "//internal/core/service",
        "//internal/server/authn",
        "//internal/server/collab",
        "//internal/server/events",
        "//internal/server/rpc",
        "//internal/server/transport/httpjson",
        "//internal/server/watch",
        "//internal/server/watchhttp",
        "//internal/server/webui",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/postgres",
        "//internal/storage/sqlite",
    ],
)

go_test(
    name = "composition_test",
    srcs = glob(["*_test.go"]),
    embed = [":composition"],
    deps = [
        "//internal/api/wire",
        "//internal/client",
        "//internal/core/model",
        "//internal/server/transport/httpjson",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/sqlite",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
