load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "webui",
    srcs = [
        "bridge.go",
        "catalog.go",
        "webui.go",
    ],
    embedsrcs = [
        "static/app.js",
        "static/favicon.svg",
        "static/index.html",
        "static/styles.css",
    ],
    importpath = "github.com/buildbetter-app/plugs/internal/server/webui",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/server/authn"],
)

go_test(
    name = "webui_test",
    srcs = [
        "bridge_test.go",
        "browser_test.go",
        "webui_test.go",
    ],
    embedsrcs = ["browser_check.mjs"],
    env_inherit = ["PATH"],
    tags = ["local"],
    embed = [":webui"],
    deps = [
        "//internal/core/model",
        "//internal/core/pipeline",
        "//internal/core/service",
        "//internal/server/authn",
        "//internal/server/rpc",
        "//internal/server/transport/httpjson",
        "//internal/storage/driver",
        "//internal/storage/memory",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
