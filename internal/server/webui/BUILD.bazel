load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "webui",
    srcs = [
        "bridge.go",
        "catalog.go",
        "webui.go",
    ],
    embedsrcs = [
        "static/app.js",
        "static/favicon.svg",
        "static/index.html",
        "static/styles.css",
    ],
    importpath = "github.com/buildbetter-app/plugs/internal/server/webui",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/server/authn"],
)

go_test(
    name = "webui_test",
    srcs = [
        "bridge_test.go",
        "browser_test.go",
        "view_watch_test.go",
        "webui_test.go",
    ],
    embedsrcs = [
        "browser_check.mjs",
        "comment_check.mjs",
        "direct_blocker_check.mjs",
        "view_watch_check.mjs",
        "watch_bootstrap_check.mjs",
    ],
    env_inherit = ["PATH"],
    tags = ["local"],
    embed = [":webui"],
    deps = [
        "//internal/core/events",
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/service",
        "//internal/core/viewops",
        "//internal/server/authn",
        "//internal/server/collab",
        "//internal/server/events",
        "//internal/server/rpc",
        "//internal/server/transport/httpjson",
        "//internal/server/viewrpc",
        "//internal/server/watch",
        "//internal/server/watchhttp",
        "//internal/storage/conformance",
        "//internal/storage/driver",
        "//internal/storage/memory",
    ],
)

go_test(
    name = "sandbox_safety_test",
    srcs = ["sandbox_test.go"],
    embedsrcs = ["sandbox_check.mjs"],
    env_inherit = ["PATH"],
    args = ["-test.v"],
    deps = [
        ":webui",
        "//internal/server/authn",
        "//internal/server/rpc",
        "//internal/server/transport/httpjson",
    ],
)

go_test(
    name = "presence_display_test",
    srcs = ["presence_display_test.go"],
    embedsrcs = ["presence_display_check.mjs"],
    env_inherit = ["PATH"],
    tags = ["local"],
    embed = [":webui"],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
