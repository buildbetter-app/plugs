go_test(
    name = "ontologymigration_test",
    srcs = ["digest_test.go", "integration_test.go", "planner_test.go", "validation_test.go"],
    embed = [":ontologymigration"],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
