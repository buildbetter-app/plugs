load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ontologymigration",
    srcs = ["digest.go", "directives.go", "guards.go", "planner.go", "types.go"],
    importpath = "github.com/buildbetter-app/plugs/internal/core/ontologymigration",
    visibility = ["//internal:__subpackages__"],
