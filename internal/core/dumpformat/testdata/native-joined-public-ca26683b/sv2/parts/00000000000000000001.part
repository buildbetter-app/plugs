{"type":"row","op":"update","key":"cGsAAAAAAAAAAAIAAAAAAAAABnN0cmluZwAAAAAAAAAEdmlldwAAAAAAAAAGc3RyaW5nAAAAAAAAAA5ibG9ja2VkX2lzc3Vlcw==","cells":[{"kind":"string","value":"view"},{"kind":"string","value":"blocked_issues"},{"kind":"string","value":"CREATE OR REPLACE VIEW blocked_issues AS\nWITH done_frozen AS (\n    SELECT name FROM custom_statuses WHERE category IN ('done', 'frozen')\n)\nSELECT\n    i.*,\n    (SELECT COUNT(*)\n     FROM dependencies d\n     WHERE d.issue_id = i.id\n       AND d.type = 'blocks'\n       AND EXISTS (\n         SELECT 1 FROM issues blocker\n         WHERE blocker.id = d.depends_on_id\n           AND blocker.status NOT IN ('closed', 'pinned')\n           AND blocker.status NOT IN (SELECT name FROM done_frozen)\n       )\n    ) as blocked_by_count\nFROM issues i\nWHERE i.status NOT IN ('closed', 'pinned')\n  AND i.status NOT IN (SELECT name FROM done_frozen)\n  AND EXISTS (\n    SELECT 1 FROM dependencies d\n    WHERE d.issue_id = i.id\n      AND d.type = 'blocks'\n      AND EXISTS (\n        SELECT 1 FROM issues blocker\n        WHERE blocker.id = d.depends_on_id\n          AND blocker.status NOT IN ('closed', 'pinned')\n          AND blocker.status NOT IN (SELECT name FROM done_frozen)\n      )\n  )"},{"kind":"string","value":"{\"CreatedAt\": 0}"},{"kind":"string","value":"NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES"}],"normalized_json":""}
