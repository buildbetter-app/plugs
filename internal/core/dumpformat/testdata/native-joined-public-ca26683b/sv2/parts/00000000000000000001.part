{"type":"row","op":"insert","key":"cGsAAAAAAAAAAAIAAAAAAAAABnN0cmluZwAAAAAAAAAEdmlldwAAAAAAAAAGc3RyaW5nAAAAAAAAAAxyZWFkeV9pc3N1ZXM=","cells":[{"kind":"string","value":"view"},{"kind":"string","value":"ready_issues"},{"kind":"string","value":"CREATE OR REPLACE VIEW ready_issues AS\nWITH RECURSIVE\n  blocked_directly AS (\n    SELECT DISTINCT d.issue_id\n    FROM dependencies d\n    WHERE d.type = 'blocks'\n      AND EXISTS (\n        SELECT 1 FROM issues blocker\n        WHERE blocker.id = d.depends_on_issue_id\n          AND blocker.status NOT IN ('closed', 'pinned')\n      )\n  ),\n  blocked_transitively AS (\n    SELECT issue_id, 0 as depth\n    FROM blocked_directly\n    UNION ALL\n    SELECT d.issue_id, bt.depth + 1\n    FROM blocked_transitively bt\n    JOIN dependencies d ON d.depends_on_issue_id = bt.issue_id\n    WHERE d.type = 'parent-child'\n      AND bt.depth \u003c 50\n  )\nSELECT i.*\nFROM issues i\nLEFT JOIN blocked_transitively bt ON bt.issue_id = i.id\nWHERE (\n    i.status = 'open'\n    OR i.status IN (SELECT name FROM custom_statuses WHERE category = 'active')\n  )\n  AND (i.ephemeral = 0 OR i.ephemeral IS NULL)\n  AND bt.issue_id IS NULL\n  AND (i.defer_until IS NULL OR i.defer_until \u003c= UTC_TIMESTAMP())\n  AND NOT EXISTS (\n    SELECT 1 FROM dependencies d_parent\n    JOIN issues parent ON parent.id = d_parent.depends_on_issue_id\n    WHERE d_parent.issue_id = i.id\n      AND d_parent.type = 'parent-child'\n      AND parent.defer_until IS NOT NULL\n      AND parent.defer_until \u003e UTC_TIMESTAMP()\n  )"},{"kind":"string","value":"{\"CreatedAt\": 0}"},{"kind":"string","value":"NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES"}],"normalized_json":""}
{"type":"row","op":"insert","key":"cGsAAAAAAAAAAAIAAAAAAAAABnN0cmluZwAAAAAAAAAEdmlldwAAAAAAAAAGc3RyaW5nAAAAAAAAAA5ibG9ja2VkX2lzc3Vlcw==","cells":[{"kind":"string","value":"view"},{"kind":"string","value":"blocked_issues"},{"kind":"string","value":"CREATE OR REPLACE VIEW blocked_issues AS\nWITH done_frozen AS (\n    SELECT name FROM custom_statuses WHERE category IN ('done', 'frozen')\n)\nSELECT\n    i.*,\n    (SELECT COUNT(*)\n     FROM dependencies d\n     WHERE d.issue_id = i.id\n       AND d.type = 'blocks'\n       AND EXISTS (\n         SELECT 1 FROM issues blocker\n         WHERE blocker.id = d.depends_on_issue_id\n           AND blocker.status NOT IN ('closed', 'pinned')\n           AND blocker.status NOT IN (SELECT name FROM done_frozen)\n       )\n    ) as blocked_by_count\nFROM issues i\nWHERE i.status NOT IN ('closed', 'pinned')\n  AND i.status NOT IN (SELECT name FROM done_frozen)\n  AND EXISTS (\n    SELECT 1 FROM dependencies d\n    WHERE d.issue_id = i.id\n      AND d.type = 'blocks'\n      AND EXISTS (\n        SELECT 1 FROM issues blocker\n        WHERE blocker.id = d.depends_on_issue_id\n          AND blocker.status NOT IN ('closed', 'pinned')\n          AND blocker.status NOT IN (SELECT name FROM done_frozen)\n      )\n  )"},{"kind":"string","value":"{\"CreatedAt\": 0}"},{"kind":"string","value":"NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES"}],"normalized_json":""}
{"type":"end_table","row_operations":2,"rows":2,"sha256":"1ec4f7cc8f0a3f4575d5aadf3d27aefd5d647400261154e0ba68622465815f3d"}
