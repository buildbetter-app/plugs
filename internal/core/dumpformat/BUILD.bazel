load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dumpformat",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/buildbetter-app/plugs/internal/core/dumpformat",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/storage/driver",
        "@org_golang_x_sys//unix",
    ],
)

go_test(
    name = "dumpformat_test",
    data = glob(["testdata/*.tar", "testdata/*.json"]) + [
        # Reuse the public capture through its existing public source group.
        "//internal/integration/converterroundtrip:lexicon_files",
    ],
    srcs = glob(["*_test.go"]),
    embed = [":dumpformat"],
    deps = [
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/storage/driver",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

exports_files(glob(["testdata/*.tar"]), visibility = ["//:__subpackages__"])
