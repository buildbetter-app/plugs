load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ontologyops",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/buildbetter-app/plugs/internal/core/ontologyops",
    visibility = ["//internal:__subpackages__"],
    deps = [
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/ontologymigration",
        "//internal/core/pipeline",
        "//internal/core/service",
        "//internal/storage/driver",
    ],
)

go_test(
    name = "ontologyops_test",
    srcs = glob(["*_test.go"]),
    embed = [":ontologyops"],
    deps = [
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/ontologymigration",
        "//internal/core/pipeline",
        "//internal/core/service",
        "//internal/storage/conformance",
        "//internal/storage/driver",
        "//internal/storage/memory",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
