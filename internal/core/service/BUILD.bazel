load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "service",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/buildbetter-app/plugs/internal/core/service",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/storage/driver",
    ],
)

go_test(
    name = "service_test",
    srcs = glob(["*_test.go"]),
    embed = [":service"],
    deps = [
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/storage/conformance",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/sqlite",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
