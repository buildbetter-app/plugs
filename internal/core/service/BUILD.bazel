load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "service",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/buildbetter-app/plugs/internal/core/service",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/core/events",
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/port",
		"//internal/core/reverseconverter",
        "//internal/storage/driver",
		"//plugins/workflow",
    ],
)

go_test(
    name = "service_test",
    srcs = glob(["*_test.go"], exclude = ["history_sqlite_rpc_test.go", "blocked_read_test.go"]),
    embed = [":service"],
    tags = ["block-network", "exclusive"],
    deps = [
        "//internal/core/events",
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/core/reverseconverter",
        "//internal/core/reverseconverter/reversetest",
        "//internal/storage/conformance",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/sqlite",
        "//internal/server/pluginhost",
        "//internal/server/events",
        "//plugins/workflow",
    ],
)

go_test(
    name = "history_sqlite_rpc_test",
    srcs = ["history_sqlite_rpc_test.go"],
    deps = [
        ":service",
        "//internal/core/model",
        "//internal/core/pipeline",
        "//internal/server/rpc",
        "//internal/server/transport/inprocess",
        "//internal/storage/driver",
        "//internal/storage/sqlite",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)


go_test(
    name = "blocked_read_test",
    srcs = ["blocked_read_test.go"],
    embed = [":service"],
    deps = [
        "//internal/core/model",
        "//internal/core/pipeline",
        "//internal/storage/conformance",
        "//internal/storage/driver",
        "//internal/storage/memory",
    ],
)
