load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "model",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/buildbetter-app/plugs/internal/core/model",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "model_test",
    srcs = glob(["*_test.go"]),
    embed = [":model"],
    embedsrcs = ["testdata/openrpc-components.json"],
    size = "small",
    deps = ["@com_github_gowebpki_jcs//:jcs"],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
