load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "reverseconverter",
    srcs = [
        "archive.go",
        "convert.go",
        "loss.go",
        "source_planes.go",
        "types.go",
    ],
    importpath = "github.com/buildbetter-app/plugs/internal/core/reverseconverter",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/dumpformat",
        "//internal/core/ontologymigration",
    ],
)

go_test(
    name = "reverseconverter_test",
    srcs = ["reverseconverter_test.go", "public_archive_test.go", "source_planes_test.go"],
    data = [
        "//internal/integration/converterroundtrip:testdata/synthetic-plug-dump-1.tar",
        "//internal/integration/converterroundtrip:public_source_fixtures",
        "//internal/integration/offlinehistory:lexicon_files",
    ],
    deps = [
        "//internal/core/dumpformat",
        "//internal/core/ontologymigration",
    ],
    embed = [":reverseconverter"],
    size = "small",
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
