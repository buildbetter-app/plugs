load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "restore",
    srcs = ["archive.go", "native_hierarchy.go", "reverse_archive.go"],
    importpath = "github.com/buildbetter-app/plugs/internal/core/restore",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/core/dumpformat",
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/service",
        "//internal/storage/driver",
    ],
)

go_test(
    name = "restore_test",
    srcs = glob(["*_test.go"]),
    data = ["//internal/integration/converterroundtrip:testdata/synthetic-plug-dump-1.tar"],
    embed = [":restore"],
    deps = [
        "//internal/api/wire",
        "//internal/cli",
        "//internal/client",
        "//internal/core/dumpformat",
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/reverseconverter",
        "//internal/core/service",
        "//internal/integration/converterroundtrip",
        "//internal/storage/conformance",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/sqlite",
    ],
    tags = ["exclusive"],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
