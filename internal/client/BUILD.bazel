load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "client",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/buildbetter-app/plugs/internal/client",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/api/wire"],
)

go_test(
    name = "client_test",
    args = ["-test.v"],
    srcs = glob(["*_test.go"]),
    embed = [":client"],
    deps = ["//internal/api/wire"],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
