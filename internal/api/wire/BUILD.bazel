load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "wire",
    srcs = ["catalog.go", "error.go", "json.go", "meta.go", "schema.go"],
    embedsrcs = ["catalog.json"],
    importpath = "github.com/buildbetter-app/plugs/internal/api/wire",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/core/model"],
)

go_test(
    name = "wire_test",
    srcs = [
        "bead_contract_test.go",
        "boundary_test.go",
        "display_name_contract_test.go",
        "restore_contract_test.go",
        "session_contract_test.go",
        "view_contract_test.go",
        "wire_test.go",
        "workflow_contract_test.go",
    ],
    data = ["//:engdocs/design/plug/contracts/openrpc.json"],
    embed = [":wire"],
    deps = ["//internal/core/model"],
)

go_test(
    name = "unsupported_contract_test",
    srcs = ["unsupported_contract_test.go"],
    data = [
        "catalog.json",
        "//:engdocs/design/plug/contracts/openrpc.json",
    ],
    deps = [
        ":wire",
        "//internal/core/model",
        "//internal/server/rpc",
    ],
)

filegroup(
    name = "reconcile_openrpc_inputs",
    srcs = ["catalog.json", "wire_test.go"],
    visibility = ["//scripts/ci:__pkg__"],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
