load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "migrationpre",
    srcs = ["compose.go"],
    importpath = "github.com/buildbetter-app/plugs/internal/integration/migrationpre",
    visibility = ["//internal:__subpackages__"],
    deps = [
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/ontologymigration",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/server/pluginhost",
        "//internal/storage/driver",
    ],
)

go_test(
    name = "migrationpre_test",
    size = "medium",
    srcs = ["integration_test.go"],
    args = ["-test.v"],
    deps = [
        ":migrationpre",
        "//internal/api/wire",
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/ontologyops",
        "//internal/core/ontologymigration",
        "//internal/core/pipeline",
        "//internal/server/ontologyrpc",
        "//internal/server/pluginhost",
        "//internal/server/rpc",
        "//internal/server/transport/inprocess",
        "//internal/storage/conformance",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//pluginapi",
        "//sdk/go:sdk_go",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
