load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "batchsql_test",
    size = "large",
    srcs = glob(["*_test.go"]),
    args = ["-test.v"],
    tags = ["exclusive", "local", "requires-network"],
    deps = [
        "//internal/core/authz",
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/core/restore",
        "//internal/core/service",
        "//internal/core/viewops",
        "//internal/plugins/authnapikey",
        "//internal/plugins/authzfixed",
        "//internal/server/authzrpc",
        "//internal/server/authn",
        "//internal/server/rpc",
        "//internal/server/transport/httpjson",
        "//internal/server/viewrpc",
        "//internal/storage/conformance",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/postgres",
        "//internal/storage/sqlite",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
