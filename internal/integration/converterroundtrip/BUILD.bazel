load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "converterroundtrip",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/buildbetter-app/plugs/internal/integration/converterroundtrip",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/core/dumpformat",
        "//internal/core/model",
        "//internal/core/nativeprojection",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/reverseconverter",
        "//internal/storage/driver",
        "//internal/storage/historyverify",
        "//internal/storage/memory",
        "//internal/storage/sqlite",
        "//internal/storage/postgres",
        "//internal/storage/depid",
        "//internal/server/pluginhost",
        "//plugins/workflow",
    ],
)

go_test(
    name = "converterroundtrip_test",
    srcs = glob(["*_test.go"]),
    data = [
        "testdata/native-built-in-statuses.json",
        "testdata/planner-predecessor-53742cc.tar.gz",
        "testdata/real-store-import-policy-v2.md",
        "testdata/public-native-delta-small-0e4d5da4.tar.gz",
        "//internal/core/dumpformat:testdata/native-tables-synthetic.tar",
        "testdata/synthetic-plug-dump-1.tar",
        ":public_source_fixtures",
        "//internal/integration/offlinehistory:lexicon_files",
        "//tools/native-receive",
    ],
    env = {"NATIVE_RECEIVE_BINARY": "$(rootpath //tools/native-receive)"},
    shard_count = 16,
    size = "large",
    tags = ["local", "requires-network"],
    embed = [":converterroundtrip"],
    deps = [
        "//internal/core/dumpformat",
        "//internal/core/model",
        "//internal/core/nativeprojection",
        "//internal/core/pipeline",
        "//internal/core/reverseconverter",
        "//internal/core/service",
        "//internal/core/port",
        "//internal/core/authz",
        "//internal/plugins/authnapikey",
        "//internal/plugins/authzfixed",
        "//internal/server/authzrpc",
        "//internal/server/composition",
        "//internal/core/restore",
        "//internal/server/transport/httpjson",
        "//internal/server/rpc",
        "//internal/core/viewops",
        "//internal/integration/b07positive",
        "//internal/storage/depid",
        "//internal/storage/driver",
        "//internal/server/pluginhost",
        "//plugins/workflow",
        "//internal/storage/memory",
        "//internal/storage/historyverify",
        "//internal/storage/postgres",
        "//internal/storage/sqlite",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

exports_files(["testdata/synthetic-plug-dump-1.tar"], visibility = ["//visibility:public"])

exports_files(["testdata/public-native-delta-small-0e4d5da4.tar.gz"], visibility = ["//internal/storage/historyverify:__pkg__"])

filegroup(
    name = "public_source_fixtures",
    srcs = [
        "testdata/public-complete-root-990eb800.tar",
        "testdata/public-history-boundary-e25cf419.tar",
        "testdata/public-multiversion-072a1a8f.tar",
        "testdata/public-own-version-d7f83c6f.tar",
        "testdata/public-partial-990eb800.tar",
    ],
    visibility = ["//visibility:public"],
)
