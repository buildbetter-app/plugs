{"type":"row","op":"insert","key":"cGsAAAAAAAAAAAIAAAAAAAAABnN0cmluZwAAAAAAAAAEdmlldwAAAAAAAAAGc3RyaW5nAAAAAAAAAA5ibG9ja2VkX2lzc3Vlcw==","cells":[{"kind":"string","value":"view"},{"kind":"string","value":"blocked_issues"},{"kind":"string","value":"CREATE OR REPLACE VIEW blocked_issues AS\nSELECT\n    i.*,\n    (SELECT COUNT(*)\n     FROM dependencies d\n     WHERE d.issue_id = i.id\n       AND d.type = 'blocks'\n       AND EXISTS (\n         SELECT 1 FROM issues blocker\n         WHERE blocker.id = d.depends_on_id\n           AND blocker.status NOT IN ('closed', 'pinned')\n       )\n    ) as blocked_by_count\nFROM issues i\nWHERE i.status NOT IN ('closed', 'pinned')\n  AND EXISTS (\n    SELECT 1 FROM dependencies d\n    WHERE d.issue_id = i.id\n      AND d.type = 'blocks'\n      AND EXISTS (\n        SELECT 1 FROM issues blocker\n        WHERE blocker.id = d.depends_on_id\n          AND blocker.status NOT IN ('closed', 'pinned')\n      )\n  )"},{"kind":"string","value":"{\"CreatedAt\": 0}"},{"kind":"string","value":"NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES"}],"normalized_json":""}
{"type":"end_table","row_operations":1,"rows":2,"sha256":"583daa73b89e5fd8f0acf6d4e6bf0edd5993323402b0e5872c3ed74afd4cd6ea"}
