load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "apikey",
    srcs = ["compose.go"],
    importpath = "github.com/buildbetter-app/plugs/internal/integration/apikey",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/core/model",
        "//internal/core/pipeline",
        "//internal/core/service",
        "//internal/plugins/authnapikey",
        "//internal/server/authn",
        "//internal/server/rpc",
        "//internal/server/transport/httpjson",
        "//internal/storage/driver",
    ],
)

go_test(
    name = "apikey_test",
    srcs = ["fixture_test.go", "http_test.go"],
    deps = [
        ":apikey",
        "//internal/core/model",
        "//internal/plugins/authnapikey",
        "//internal/server/authn",
        "//internal/server/transport/httpjson",
        "//internal/storage/driver",
        "//internal/storage/memory",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
