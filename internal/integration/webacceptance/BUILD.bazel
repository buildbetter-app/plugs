load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "webacceptance_test",
    size = "large",
    srcs = glob(["*_test.go"], exclude = ["presence_adapter_test.go"]),
    embedsrcs = ["browser_check.mjs", "e3_browser_check.mjs"],
    env_inherit = ["PATH", "PLUG_P33_REAL_DOCKER"],
    args = ["-test.v"],
    tags = ["exclusive"],
    deps = [
        "//internal/api/wire",
        "//internal/core/events",
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/service",
        "//internal/core/viewops",
        "//internal/server/authn",
        "//internal/server/collab",
        "//internal/server/events",
        "//internal/server/rpc",
        "//internal/server/transport/httpjson",
        "//internal/server/viewrpc",
        "//internal/server/watch",
        "//internal/server/watchhttp",
        "//internal/server/webui",
        "//internal/storage/conformance",
        "//internal/storage/driver",
        "//internal/storage/postgres",
        "//internal/storage/sqlite",
    ],
)

# Pure acceptance adapter: no real server/database/browser TestMain.
filegroup(
    name = "presence_adapter",
    srcs = ["presence_dom_adapter.mjs"],
)

go_test(
    name = "presence_adapter_test",
    srcs = ["presence_adapter_test.go"],
    embedsrcs = [":presence_adapter", "presence_adapter_check.mjs"],
    env_inherit = ["PATH"],
    args = ["-test.v"],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
