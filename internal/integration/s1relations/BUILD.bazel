load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "s1relations_test",
    srcs = glob(["*_test.go"]),
    size = "large",
    args = [
        "-archive=$(rlocationpath //internal/integration/converterroundtrip:testdata/synthetic-plug-dump-1.tar)",
        "-reference=$(rlocationpath //spec/recorded/extension:extension.json)",
        "-test.v",
    ],
    data = [
        "//internal/integration/converterroundtrip:testdata/synthetic-plug-dump-1.tar",
        "//spec/recorded/extension:extension.json",
    ],
    tags = ["local", "requires-network"],
    deps = [
        "//internal/core/model",
        "//internal/core/ontology",
        "//internal/core/pipeline",
        "//internal/core/port",
        "//internal/core/service",
        "//internal/integration/converterroundtrip",
        "//internal/server/rpc",
        "//internal/server/transport/inprocess",
        "//internal/storage/driver",
        "//internal/storage/memory",
        "//internal/storage/postgres",
        "//internal/storage/sqlite",
    ],
)

filegroup(
    name = "lexicon_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
