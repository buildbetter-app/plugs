{
  "base": {
    "statuses": {
      "todo": {
        "name": "Todo",
        "category": "active"
      },
      "doing": {
        "name": "Doing",
        "category": "wip"
      },
      "done": {
        "name": "Done",
        "category": "done",
        "outcome": "success"
      },
      "shelved": {
        "name": "Shelved",
        "category": "frozen"
      },
      "abandoned": {
        "name": "Abandoned",
        "category": "canceled"
      }
    },
    "workflows": {
      "host": {
        "statuses": [
          "todo",
          "doing",
          "done",
          "shelved",
          "abandoned"
        ],
        "initial": "todo",
        "slots": {
          "claim": "doing",
          "close": "done",
          "reopen": "todo",
          "defer": "shelved",
          "cancel": "abandoned"
        },
        "transitions": [
          {
            "to": "done",
            "guards": [
              {
                "kind": "not_template"
              },
              {
                "kind": "no_open_children"
              },
              {
                "kind": "no_open_blockers"
              },
              {
                "kind": "permission"
              }
            ]
          },
          {
            "to": "doing",
            "guards": [
              {
                "kind": "no_open_blockers"
              }
            ]
          },
          {
            "to": "todo"
          },
          {
            "to": "shelved"
          },
          {
            "to": "abandoned",
            "guards": [
              {
                "kind": "permission"
              }
            ]
          }
        ]
      }
    },
    "types": {
      "task": {
        "name": "Task",
        "workflow": "host",
        "fields": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  },
  "overlays": {
    "signals-v2": {
      "statuses": {
        "queued": {
          "name": "Queued",
          "category": "active"
        },
        "shipping": {
          "name": "Shipping",
          "category": "wip"
        },
        "resolved": {
          "name": "Resolved",
          "category": "done",
          "outcome": "success"
        },
        "todo": {
          "name": "Todo",
          "category": "frozen"
        }
      },
      "workflows": {
        "host": {
          "statuses": [
            "queued",
            "shipping",
            "resolved",
            "todo"
          ],
          "initial": "queued",
          "slots": {
            "claim": "shipping",
            "close": "resolved",
            "reopen": "queued",
            "defer": "todo"
          },
          "transitions": [
            {
              "to": "resolved",
              "guards": [
                {
                  "kind": "not_template"
                },
                {
                  "kind": "no_open_children"
                },
                {
                  "kind": "no_open_blockers"
                },
                {
                  "kind": "permission"
                }
              ]
            },
            {
              "to": "shipping",
              "guards": [
                {
                  "kind": "no_open_blockers"
                }
              ]
            },
            {
              "to": "queued"
            },
            {
              "to": "todo"
            }
          ]
        }
      }
    }
  }
}
